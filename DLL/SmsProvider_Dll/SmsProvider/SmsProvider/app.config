<?xml version="1.0"?>
<configuration>
    <configSections>
        <sectionGroup name="applicationSettings" type="System.Configuration.ApplicationSettingsGroup, System, Version=2.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089">
            <section name="SmsProvider.My.MySettings" type="System.Configuration.ClientSettingsSection, System, Version=2.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false"/>
        </sectionGroup>
    </configSections>
    <system.diagnostics>
        <sources>
            <!-- This section defines the logging configuration for My.Application.Log -->
            <source name="DefaultSource" switchName="DefaultSwitch">
                <listeners>
                    <add name="FileLog"/>
                    <!-- Uncomment the below section to write to the Application Event Log -->
                    <!--<add name="EventLog"/>-->
                </listeners>
            </source>
        </sources>
        <switches>
            <add name="DefaultSwitch" value="Information"/>
        </switches>
        <sharedListeners>
            <add name="FileLog" type="Microsoft.VisualBasic.Logging.FileLogTraceListener, Microsoft.VisualBasic, Version=8.0.0.0, Culture=neutral, PublicKeyToken=b03f5f7f11d50a3a, processorArchitecture=MSIL" initializeData="FileLogWriter"/>
            <!-- Uncomment the below section and replace APPLICATION_NAME with the name of your application to write to the Application Event Log -->
            <!--<add name="EventLog" type="System.Diagnostics.EventLogTraceListener" initializeData="APPLICATION_NAME"/> -->
        </sharedListeners>
    </system.diagnostics>
    <applicationSettings>
        <SmsProvider.My.MySettings>
            <setting name="SmsProvider_com_adpdigital_ws2_JaxRpcMessagingServiceService"
                serializeAs="String">
                <value>http://ws2.adpdigital.com/services/MessagingService</value>
            </setting>
            <setting name="SmsProvider_com_parsasms_v2" serializeAs="String">
                <value>http://parsasms.com/webservice/v2.asmx</value>
            </setting>
            <setting name="SmsProvider_WebReferenceNiazPardaz_SendService"
                serializeAs="String">
                <value>http://5.9.76.186/SendService.svc</value>
            </setting>
            <setting name="SmsProvider_WebReferenceMana_SendService" serializeAs="String">
                <value> http://37.130.202.188/class/sms/wssimple/server</value>
            </setting>
            <setting name="SmsProvider_ir_avapayam_Send" serializeAs="String">
                <value>http://avapayam.ir/Post/Send.asmx</value>
            </setting>
            <setting name="SmsProvider_com_sunwaysms_sms_SMS" serializeAs="String">
                <value>http://sms.sunwaysms.com/smsws/soap.asmx</value>
            </setting>
            <setting name="SmsProvider_ir_payamak_service1_SendService" serializeAs="String">
                <value>http://payamak-service.ir/SendService.svc</value>
            </setting>
            <setting name="SmsProvider_ir_firstpayamak_ui_v2" serializeAs="String">
                <value>http://ui.firstpayamak.ir/webservice/v2.asmx</value>
            </setting>
            <setting name="SmsProvider_com_payamak_panel_api_Send" serializeAs="String">
                <value>http://api.payamak-panel.com/post/Send.asmx</value>
            </setting>
            <setting name="SmsProvider_ir_smsapp_v2" serializeAs="String">
                <value>http://smsapp.ir/webservice/v2.asmx</value>
            </setting>
            <setting name="SmsProvider_com_hafezpayam_messagingws_SendSMS"
                serializeAs="String">
                <value>http://messagingws.hafezpayam.com/sendSMS.asmx</value>
            </setting>
            <setting name="SmsProvider_WebReference_Send" serializeAs="String">
                <value>http://87.107.121.52/post/send.asmx</value>
            </setting>
        </SmsProvider.My.MySettings>
    </applicationSettings>
<startup><supportedRuntime version="v2.0.50727"/></startup><system.serviceModel>
        <bindings />
        <client />
    </system.serviceModel>
</configuration>
